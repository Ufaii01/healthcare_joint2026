generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String   @default("")
  email        String   @unique
  age          String   @default("")
  gender       String   @default("")
  contact      String   @default("")
  address      String   @default("")
  avatar       String   @default("") @db.Text

  passwordHash String?

  language       String  @default("Bahasa Indonesia")
  bookingUpdates Boolean @default(true)
  resultAlerts   Boolean @default(true)
  healthTips     Boolean @default(false)
  twoFactor      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Member[]
  orders      Order[]
  quizAnswers QuizAnswer[]
  results     ResultEntry[]

  @@map("users")
}

model Member {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  age    String
  gender String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderUnits OrderUnit[]
  results    ResultEntry[]

  @@index([userId])
  @@map("members")
}

model Order {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  version Int @default(2)

  labId   String
  date    String
  slot    String
  address String
  notes   String @default("")
  pay     String
  total   Int
  step    Int    @default(0)

  courierName  String
  courierRole  String
  courierPlate String
  courierPhone String

  createdAt DateTime @default(now())

  units   OrderUnit[]
  results ResultEntry[]

  @@index([userId])
  @@map("orders")
}

model OrderUnit {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  testKey   String
  unitIndex Int

  ownerId  String
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId String?

  @@unique([orderId, testKey, unitIndex])
  @@index([orderId])
  @@index([memberId])
  @@map("order_units")
}

model QuizAnswer {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  options    Int[]

  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@map("quiz_answers")
}

model ResultEntry {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  date   String
  label  String
  metric String
  value  Float
  lab    String

  ownerId  String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([memberId])
  @@map("results")
}
